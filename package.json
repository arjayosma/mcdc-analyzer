{
  "name": "mcdc-analyzer",
  "version": "0.2.0",
  "description": "MC/DC (modified condition/decision coverage) analyzer for JavaScript and TypeScript: a browser app plus a Vitest plugin that measures MC/DC coverage of your real test suite",
  "license": "MIT",
  "author": "Arjay Osma",
  "homepage": "https://arjayosma.github.io/mcdc-analyzer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arjayosma/mcdc-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/arjayosma/mcdc-analyzer/issues"
  },
  "keywords": [
    "mcdc",
    "mc/dc",
    "coverage",
    "modified-condition-decision-coverage",
    "test-coverage",
    "do-178c",
    "iso-26262",
    "static-analysis",
    "typescript",
    "javascript",
    "vitest",
    "vitest-plugin"
  ],
  "type": "module",
  "exports": {
    "./vitest": {
      "types": "./dist-lib/vitest.d.ts",
      "import": "./dist-lib/vitest.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:lib": "vite build --config vite.lib.config.ts",
    "test:e2e": "npm run build:lib && vitest run --config vitest.e2e.config.ts",
    "prepublishOnly": "npm run check && npm run test:e2e"
  },
  "engines": {
    "node": ">=20.19"
  },
  "peerDependencies": {
    "vite": ">=6.0.0",
    "vitest": ">=4.0.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/types": "^7.29.8",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@eslint/js": "^9.39.5",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^22.20.5",
    "elkjs": "^0.12.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "magic-string": "^0.30.21",
    "sucrase": "^3.35.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.1.0",
    "vitest": "^4.0.0"
  }
}
